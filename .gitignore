# ========== Unity Generated Folders ==========
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/
UserSettings/

# ========== Rider / VS / VS Code ==========
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# ========== Operating System Files ==========
.DS_Store
Thumbs.db
desktop.ini

# ========== Package Manager ==========
*.unitypackage
*.tgz
*.zip
*.apk
*.aab

# ========== Git LFS 管理大型資源（由 .gitattributes 控制） ==========
# 不需在這裡排除，由 LFS 管理即可

# ========== Firebase SDK（避免大型原生檔案佔版控） ==========
Assets/Firebase/Plugins/**/*.so
Assets/Firebase/Plugins/**/*.bundle

# ========== 保留必要 .meta（空資料夾追蹤） ==========
!Assets/**/*.meta
!Packages/**/*.meta
!ProjectSettings/**/*.meta
!*/.gitkeep
